# DualView OpenClaw — Environment Configuration
# Copy to .env and fill in your values.
# Priority: CLI flags > environment variables > .env file

# LLM API Keys (at least one required)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# OpenRouter (Qwen3.5-9B)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.5-9b

# Microsoft Foundry (Qwen3.5-4B)
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_KEY=
# FOUNDRY_MODEL=qwen35-4b

# OpenAI Codex (ChatGPT) OAuth — alternative to OPENAI_API_KEY.
# Source: ~/.codex/auth.json (auto-loaded locally if present).
# In CI, set these explicitly. OPENAI_CODEX_EMAIL/ACCOUNT_ID are optional.
# OPENAI_CODEX_ACCESS=
# OPENAI_CODEX_REFRESH=
# OPENAI_CODEX_ACCOUNT_ID=
# OPENAI_CODEX_EMAIL=

# GitHub Copilot — alternatively run:
# openclaw models auth login-github-copilot
# COPILOT_GITHUB_TOKEN=

# Tool Keys (optional)
# BRAVE_API_KEY=

# Channel tokens (optional; setup script auto-detects configured channels)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_MODE=socket
# SLACK_SIGNING_SECRET=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# Bot setup (optional)
# DUALVIEW_BOT_CHANNELS=auto
# DUALVIEW_BOT_MODEL=openai-codex/gpt-5.3-codex-spark
# DUALVIEW_BOT_INSPECT_MODEL=openai-codex/gpt-5.3-codex-spark
# DUALVIEW_TARGET_CHANNELS=slack:C0123456789
# DUALVIEW_TARGET_SESSION_IDS=
# DUALVIEW_DISABLED_TARGET_CHANNELS=slack:C0123456789
# DUALVIEW_DISABLED_TARGET_SESSION_IDS=
# DUALVIEW_GATEWAY_TOKEN=dualview-bot

# DualView dashboard (optional)
# DASHBOARD_PORT=3456
# DASHBOARD_PASSWORD=
# DUALVIEW_WORKSPACE_DIR=
# DUALVIEW_EVAL_DIR=

# Slack symbol links -> dashboard (optional)
# Symbols in Slack replies link to the dashboard. Set the port (and host) so the
# bot builds http://<host>:<port>/bot/ links. The scripts default the host to
# this machine's FQDN when only the port is set. For a full custom base URL
# (scheme/path), set DUALVIEW_DASHBOARD_URL instead.
# DUALVIEW_DASHBOARD_PORT=13457
# DUALVIEW_DASHBOARD_HOST=dashboard.example.test
# DUALVIEW_DASHBOARD_URL=http://dashboard.example.test:13457/
